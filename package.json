{
  "name": "lernlab-monorepo",
  "version": "1.1.1",
  "private": true,
  "description": "Free, open-source, local-first study app: turn any deck into short game rounds with spaced repetition. Like Anki, but fun.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "bench"
  ],
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "tsx --no-warnings apps/desktop/server/index.ts",
    "dev": "NODE_NO_WARNINGS=1 LERNLAB_DEV=1 tsx watch --ignore ./data apps/desktop/server/index.ts",
    "build": "npm run --workspace apps/desktop build",
    "build:electron": "npm run --workspace apps/desktop build:electron",
    "desktop": "npm run --workspace apps/desktop desktop",
    "dist": "npm run --workspace apps/desktop dist",
    "dist:mac": "npm run --workspace apps/desktop dist:mac",
    "dist:win": "npm run --workspace apps/desktop dist:win",
    "dist:linux": "npm run --workspace apps/desktop dist:linux",
    "import": "tsx --no-warnings apps/desktop/server/cli-import.ts",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspace packages/core",
    "fuzz": "npm run fuzz --workspace packages/core",
    "test:e2e": "npm run build:electron && npm run --workspace apps/desktop e2e",
    "bench": "npm run bench --workspace bench",
    "bench:startup": "npm run startup --workspace bench --",
    "bench:budgets": "npm run budgets --workspace bench --",
    "test:visual": "npm run --workspace apps/desktop visual",
    "storybook": "npm run --workspace apps/desktop storybook",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/n1m5l5ss/lernlab.git"
  }
}
