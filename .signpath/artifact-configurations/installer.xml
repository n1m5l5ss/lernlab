<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (docs/CODE_SIGNING.md). The GitHub artifact holds
     the one NSIS installer, LernLab-Setup-X.Y.Z.exe, built from the already signed app. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="LernLab-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
