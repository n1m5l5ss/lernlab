<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app" (docs/CODE_SIGNING.md). The GitHub artifact is the
     unpacked Windows app (release/win-unpacked). Only LernLab's own program is signed; the
     Electron and Chromium libraries next to it stay as their makers shipped them. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="LernLab.exe" product-name="LernLab">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
